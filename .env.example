# Credentials for goldbot.
#
# The DEFAULT daily cadence needs NONE of these. Stooq end-of-day data is
# unauthenticated, so a standard backtest and a daily paper session run with no
# secrets at all.
#
# These are required only if you enable the optional 4-hour cadence, which
# needs an intraday data source.
#
# Copy to .env (which is gitignored) and fill in. Never commit real values.

# Optional — only for --cadence 4h
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional — alternative end-of-day source with documented terms
TIINGO_API_KEY=
